{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trace": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "chrome-trace.1"
            },
            "sourceName": {
              "$ref": "#/$defs/__schema0"
            },
            "contentHash": {
              "$ref": "#/$defs/__schema0"
            },
            "originMicroseconds": {
              "type": "number"
            },
            "rawEventCount": {
              "$ref": "#/$defs/__schema1"
            },
            "ignoredPhases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "phase": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "count": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "required": [
                  "phase",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "zeroDurationCount": {
              "$ref": "#/$defs/__schema1"
            },
            "events": {
              "maxItems": 100000,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            }
          },
          "required": [
            "version",
            "sourceName",
            "contentHash",
            "originMicroseconds",
            "rawEventCount",
            "ignoredPhases",
            "zeroDurationCount",
            "events"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "rocm-timestamps.1"
            },
            "sourceName": {
              "$ref": "#/$defs/__schema0"
            },
            "contentHash": {
              "$ref": "#/$defs/__schema0"
            },
            "originNanoseconds": {
              "$ref": "#/$defs/__schema6"
            },
            "rawEventCount": {
              "$ref": "#/$defs/__schema1"
            },
            "ignoredColumns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "zeroDurationCount": {
              "$ref": "#/$defs/__schema1"
            },
            "events": {
              "maxItems": 100000,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            }
          },
          "required": [
            "version",
            "sourceName",
            "contentHash",
            "originNanoseconds",
            "rawEventCount",
            "ignoredColumns",
            "zeroDurationCount",
            "events"
          ],
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "startSeconds": {
          "$ref": "#/$defs/__schema3"
        },
        "endSeconds": {
          "$ref": "#/$defs/__schema3"
        },
        "category": {
          "type": "string"
        },
        "pid": {
          "$ref": "#/$defs/__schema0"
        },
        "tid": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceDevice": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceQueue": {
          "$ref": "#/$defs/__schema0"
        },
        "nameContains": {
          "type": "string"
        },
        "eventIndices": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "overrides": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema10"
      }
    },
    "scenarioId": {
      "$ref": "#/$defs/__schema0"
    },
    "phase": {
      "type": "string",
      "enum": [
        "prefill",
        "decode"
      ]
    },
    "deviceIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "interval": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "trace",
    "selection",
    "rules",
    "overrides",
    "scenarioId",
    "phase",
    "deviceIds",
    "interval"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "index": {
          "$ref": "#/$defs/__schema1"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "category": {
          "type": "string"
        },
        "pid": {
          "$ref": "#/$defs/__schema0"
        },
        "tid": {
          "$ref": "#/$defs/__schema0"
        },
        "startSeconds": {
          "$ref": "#/$defs/__schema3"
        },
        "seconds": {
          "$ref": "#/$defs/__schema4"
        },
        "rawStartMicroseconds": {
          "type": "number"
        },
        "rawDurationMicroseconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceDevice": {
          "type": "string"
        },
        "correlation": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "index",
        "name",
        "category",
        "pid",
        "tid",
        "startSeconds",
        "seconds",
        "rawStartMicroseconds",
        "rawDurationMicroseconds"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "number",
      "minimum": 0
    },
    "__schema4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,19})$"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "index": {
          "$ref": "#/$defs/__schema1"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "category": {
          "type": "string",
          "const": "ROCm kernel"
        },
        "pid": {
          "$ref": "#/$defs/__schema0"
        },
        "tid": {
          "$ref": "#/$defs/__schema0"
        },
        "startSeconds": {
          "$ref": "#/$defs/__schema3"
        },
        "seconds": {
          "$ref": "#/$defs/__schema4"
        },
        "sourceDevice": {
          "$ref": "#/$defs/__schema0"
        },
        "correlation": {
          "$ref": "#/$defs/__schema5"
        },
        "rawStartNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "rawEndNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "dispatchId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceQueue": {
          "$ref": "#/$defs/__schema0"
        },
        "csvLine": {
          "minimum": 2,
          "$ref": "#/$defs/__schema1"
        },
        "rawDispatchNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "rawCompleteNanoseconds": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "index",
        "name",
        "category",
        "pid",
        "tid",
        "startSeconds",
        "seconds",
        "sourceDevice",
        "rawStartNanoseconds",
        "rawEndNanoseconds",
        "dispatchId",
        "sourceQueue",
        "csvLine"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "category": {
          "type": "string"
        },
        "pid": {
          "$ref": "#/$defs/__schema0"
        },
        "tid": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceDevice": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceQueue": {
          "$ref": "#/$defs/__schema0"
        },
        "target": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "ruleId",
        "name",
        "target"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "module"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "eventIndex": {
          "$ref": "#/$defs/__schema1"
        },
        "target": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "eventIndex",
        "target"
      ],
      "additionalProperties": false
    }
  }
}
