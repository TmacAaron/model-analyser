{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "validation",
        "reference",
        "conflict",
        "io",
        "not_found",
        "unsupported_version"
      ]
    },
    "message": {
      "$ref": "#/$defs/__schema0"
    },
    "fieldIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "currentRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "code",
    "message",
    "fieldIssues"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
