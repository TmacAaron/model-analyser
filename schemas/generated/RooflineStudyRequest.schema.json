{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "module"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "decodeStep": {
      "$ref": "#/$defs/__schema1"
    },
    "scan": {
      "type": "object",
      "properties": {
