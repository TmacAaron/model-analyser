{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seriesId": {
      "type": "string",
      "minLength": 1
    },
    "roof": {
      "type": "string",
      "enum": [
        "effective",
        "hardware"
      ]
    },
    "knownPoints": {
      "$ref": "#/$defs/__schema0"
    },
    "expectedPoints": {
      "minimum": 1,
      "$ref": "#/$defs/__schema0"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "balanced_samples",
              "regime_change"
            ]
          },
          "lower": {
            "$ref": "#/$defs/__schema0"
          },
          "upper": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "kind",
          "lower",
          "upper"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "seriesId",
    "roof",
    "knownPoints",
    "expectedPoints",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
