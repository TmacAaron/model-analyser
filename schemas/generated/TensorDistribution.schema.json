{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "replicated"
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "groupId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "partial"
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        },
        "reduceOperation": {
          "type": "string",
          "enum": [
            "sum",
            "max",
            "min"
          ]
        }
      },
      "required": [
        "kind",
        "groupId",
        "reduceOperation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "sharded"
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        },
        "axes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "policy": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "even"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "padded"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "explicit"
                },
                "slices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "deviceId": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "axisId": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "start": {
                        "$ref": "#/$defs/__schema2"
                      },
                      "end": {
                        "$ref": "#/$defs/__schema2"
                      }
                    },
                    "required": [
                      "deviceId",
                      "axisId",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "kind",
                "slices"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "kind",
        "groupId",
        "axes",
        "policy"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "manual"
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": {
                "$ref": "#/$defs/__schema0"
              },
              "localShape": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "axisId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "semantic": {
                      "type": "string",
                      "enum": [
                        "batch",
                        "token",
                        "head",
                        "hidden",
                        "expert",
                        "vocab",
                        "custom"
                      ]
                    },
                    "size": {
                      "$ref": "#/$defs/__schema3"
                    }
                  },
                  "required": [
                    "axisId",
                    "semantic",
                    "size"
                  ],
                  "additionalProperties": false
                }
              },
              "copies": {
                "$ref": "#/$defs/__schema4"
              }
            },
            "required": [
              "deviceId",
              "localShape",
              "copies"
            ],
            "additionalProperties": false
          }
        },
        "description": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "groupId",
        "members",
        "description"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "tensorAxisId": {
          "$ref": "#/$defs/__schema0"
        },
        "meshAxisId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "tensorAxisId",
        "meshAxisId"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "quantity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "scalar",
                    "count",
                    "ratio",
                    "byte",
                    "second",
                    "operation",
                    "operation_per_second",
                    "byte_per_second"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "call": {
              "type": "object",
              "properties": {
                "formula": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema4"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "model",
                        "module",
                        "operator",
                        "formula",
                        "parallel",
                        "quantization",
                        "hardware"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "revision",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "bindings": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema3"
                  }
                }
              },
              "required": [
                "formula",
                "bindings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema4": {
      "minimum": 1,
      "$ref": "#/$defs/__schema2"
    }
  }
}
