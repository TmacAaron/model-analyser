{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "roofline_bound"
        },
        "computeEfficiency": {
          "$ref": "#/$defs/__schema0"
        },
        "memoryEfficiency": {
          "$ref": "#/$defs/__schema0"
        },
        "computeMemoryOverlap": {
          "type": "string",
          "enum": [
            "ideal",
            "serial"
          ]
        },
        "launchSeconds": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "computeEfficiency",
        "memoryEfficiency",
        "computeMemoryOverlap",
        "launchSeconds"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "custom_formula"
        },
        "seconds": {
          "$ref": "#/$defs/__schema2"
        },
        "description": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "kind",
        "seconds",
        "description"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fixed"
        },
        "seconds": {
          "$ref": "#/$defs/__schema1"
        },
        "description": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "kind",
        "seconds",
        "description"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    },
    "__schema2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "quantity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "scalar",
                    "count",
                    "ratio",
                    "byte",
                    "second",
                    "operation",
                    "operation_per_second",
                    "byte_per_second"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "call": {
              "type": "object",
              "properties": {
                "formula": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "model",
                        "module",
                        "operator",
                        "formula",
                        "parallel",
                        "quantization",
                        "hardware"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "revision",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "bindings": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/__schema3"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema2"
                  }
                }
              },
              "required": [
                "formula",
                "bindings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    }
  }
}
