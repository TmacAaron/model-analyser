{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "diagnosticId": {
      "$ref": "#/$defs/__schema0"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "code": {
      "$ref": "#/$defs/__schema0"
    },
    "message": {
      "$ref": "#/$defs/__schema0"
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "asset"
            },
            "assetId": {
              "$ref": "#/$defs/__schema0"
            },
            "fieldPath": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "assetId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            },
            "fieldPath": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scenario"
            },
            "scenarioId": {
              "$ref": "#/$defs/__schema0"
            },
            "fieldPath": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "scenarioId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "name": {
              "$ref": "#/$defs/__schema0"
            },
            "line": {
              "$ref": "#/$defs/__schema1"
            },
            "column": {
              "$ref": "#/$defs/__schema1"
            },
            "fieldPath": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "diagnosticId",
    "severity",
    "code",
    "message",
    "location"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
