{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodeId": {
      "$ref": "#/$defs/__schema0"
    },
    "deviceScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "per_device"
            },
            "deviceId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "deviceId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "equivalence_class"
            },
            "classId": {
              "$ref": "#/$defs/__schema0"
            },
            "deviceIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "kind",
            "classId",
            "deviceIds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "streamId": {
      "$ref": "#/$defs/__schema0"
    },
    "startSeconds": {
      "$ref": "#/$defs/__schema1"
    },
    "endSeconds": {
      "$ref": "#/$defs/__schema1"
    },
    "decodeStepIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "nodeId",
    "deviceScope",
    "streamId",
    "startSeconds",
    "endSeconds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "number",
      "minimum": 0
    }
  }
}
