{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "expectedProjectRevision": {
      "$ref": "#/$defs/__schema1"
    },
    "scenarioId": {
      "$ref": "#/$defs/__schema0"
    },
    "selections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "planHash": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "requestId",
    "projectId",
    "expectedProjectRevision",
    "scenarioId",
    "selections",
    "planHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/__schema3"
        },
        "to": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "assetId": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "module",
            "operator",
            "formula",
            "parallel",
            "quantization",
            "hardware"
          ]
        }
      },
      "required": [
        "assetId",
        "revision",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
