{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "per_device"
        },
        "deviceId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "deviceId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "equivalence_class"
        },
        "classId": {
          "$ref": "#/$defs/__schema0"
        },
        "deviceIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "kind",
        "classId",
        "deviceIds"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
