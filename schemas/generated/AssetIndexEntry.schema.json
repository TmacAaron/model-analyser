{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "type": "string",
      "enum": [
        "model",
        "module",
        "operator",
        "formula",
        "parallel",
        "quantization",
        "hardware"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "$ref": "#/$defs/__schema0"
    },
    "origin": {
      "type": "string",
      "enum": [
        "builtin",
        "user"
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "format": {
      "type": "string",
      "enum": [
        "json",
        "yaml"
      ]
    },
    "family": {
      "$ref": "#/$defs/__schema0"
    },
    "configModelTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "assetId",
    "kind",
    "revision",
    "name",
    "origin",
    "archived",
    "format"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
