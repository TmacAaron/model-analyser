{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "chrome-trace.1"
        },
        "sourceName": {
          "$ref": "#/$defs/__schema0"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema0"
        },
        "originMicroseconds": {
          "type": "number"
        },
        "rawEventCount": {
          "$ref": "#/$defs/__schema1"
        },
        "ignoredPhases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "$ref": "#/$defs/__schema0"
              },
              "count": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "phase",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "zeroDurationCount": {
          "$ref": "#/$defs/__schema1"
        },
        "events": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "version",
        "sourceName",
        "contentHash",
        "originMicroseconds",
        "rawEventCount",
        "ignoredPhases",
        "zeroDurationCount",
        "events"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "rocm-timestamps.1"
        },
        "sourceName": {
          "$ref": "#/$defs/__schema0"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema0"
        },
        "originNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "rawEventCount": {
          "$ref": "#/$defs/__schema1"
        },
        "ignoredColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "zeroDurationCount": {
          "$ref": "#/$defs/__schema1"
        },
        "events": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        }
      },
      "required": [
        "version",
        "sourceName",
        "contentHash",
        "originNanoseconds",
        "rawEventCount",
        "ignoredColumns",
        "zeroDurationCount",
        "events"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "index": {
          "$ref": "#/$defs/__schema1"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "category": {
          "type": "string"
        },
        "pid": {
          "$ref": "#/$defs/__schema0"
        },
        "tid": {
          "$ref": "#/$defs/__schema0"
        },
        "startSeconds": {
          "$ref": "#/$defs/__schema3"
        },
        "seconds": {
          "$ref": "#/$defs/__schema4"
        },
        "rawStartMicroseconds": {
          "type": "number"
        },
        "rawDurationMicroseconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceDevice": {
          "type": "string"
        },
        "correlation": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "index",
        "name",
        "category",
        "pid",
        "tid",
        "startSeconds",
        "seconds",
        "rawStartMicroseconds",
        "rawDurationMicroseconds"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "number",
      "minimum": 0
    },
    "__schema4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,19})$"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "index": {
          "$ref": "#/$defs/__schema1"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "category": {
          "type": "string",
          "const": "ROCm kernel"
        },
        "pid": {
          "$ref": "#/$defs/__schema0"
        },
        "tid": {
          "$ref": "#/$defs/__schema0"
        },
        "startSeconds": {
          "$ref": "#/$defs/__schema3"
        },
        "seconds": {
          "$ref": "#/$defs/__schema4"
        },
        "sourceDevice": {
          "$ref": "#/$defs/__schema0"
        },
        "correlation": {
          "$ref": "#/$defs/__schema5"
        },
        "rawStartNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "rawEndNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "dispatchId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceQueue": {
          "$ref": "#/$defs/__schema0"
        },
        "csvLine": {
          "minimum": 2,
          "$ref": "#/$defs/__schema1"
        },
        "rawDispatchNanoseconds": {
          "$ref": "#/$defs/__schema6"
        },
        "rawCompleteNanoseconds": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "index",
        "name",
        "category",
        "pid",
        "tid",
        "startSeconds",
        "seconds",
        "sourceDevice",
        "rawStartNanoseconds",
        "rawEndNanoseconds",
        "dispatchId",
        "sourceQueue",
        "csvLine"
      ],
      "additionalProperties": false
    }
  }
}
