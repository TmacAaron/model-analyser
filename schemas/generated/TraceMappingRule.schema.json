    },
    "name": {
      "$ref": "#/$defs/__schema0"
    },
    "category": {
      "type": "string"
    },
    "pid": {
      "$ref": "#/$defs/__schema0"
    },
    "tid": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceDevice": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceQueue": {
      "$ref": "#/$defs/__schema0"
    },
    "target": {
