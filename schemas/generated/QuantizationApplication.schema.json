{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "storageId": {
      "$ref": "#/$defs/__schema0"
    },
    "category": {
      "type": "string",
      "enum": [
        "weight",
        "activation",
        "state"
      ]
    },
    "nodeIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "assignmentIndices": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "overriddenIndices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "shape": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axisId": {
            "$ref": "#/$defs/__schema0"
          },
          "semantic": {
            "type": "string",
            "enum": [
              "batch",
              "token",
              "head",
              "hidden",
              "expert",
              "vocab",
              "custom"
            ]
          },
          "size": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "axisId",
          "semantic",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "dtype": {
      "$ref": "#/$defs/__schema4"
    },
    "beforeBytes": {
      "$ref": "#/$defs/__schema1"
    },
    "afterBytes": {
      "$ref": "#/$defs/__schema1"
    },
    "specification": {
      "$ref": "#/$defs/__schema5"
    },
    "previousSpecification": {
      "$ref": "#/$defs/__schema5"
    },
    "allocationOverridden": {
      "type": "boolean"
    },
    "allocationOverrideBytes": {
      "$ref": "#/$defs/__schema1"
    },
    "importOrigins": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    }
  },
  "required": [
    "storageId",
    "category",
    "nodeIds",
    "assignmentIndices",
    "overriddenIndices",
    "shape",
    "dtype",
    "beforeBytes",
    "afterBytes",
    "specification",
    "allocationOverridden"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "quantity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "scalar",
                    "count",
                    "ratio",
                    "byte",
                    "second",
                    "operation",
                    "operation_per_second",
                    "byte_per_second"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "call": {
              "type": "object",
              "properties": {
                "formula": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "model",
                        "module",
                        "operator",
                        "formula",
                        "parallel",
                        "quantization",
                        "hardware"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "revision",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "bindings": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema2"
                  }
                }
              },
              "required": [
                "formula",
                "bindings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema3": {
      "minimum": 1,
      "$ref": "#/$defs/__schema1"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "float",
            "int",
            "uint",
            "custom"
          ]
        },
        "bits": {
          "$ref": "#/$defs/__schema3"
        },
        "format": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "category",
        "bits",
        "format"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "payloadBits": {
          "$ref": "#/$defs/__schema3"
        },
        "payloadDtype": {
          "$ref": "#/$defs/__schema4"
        },
        "packingUnitElements": {
          "$ref": "#/$defs/__schema3"
        },
        "alignmentBytes": {
          "$ref": "#/$defs/__schema3"
        },
        "auxiliaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/__schema0"
              },
              "dtype": {
                "$ref": "#/$defs/__schema4"
              },
              "count": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "formula"
                      },
                      "value": {
                        "$ref": "#/$defs/__schema2"
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "group"
                      },
                      "groupSize": {
                        "$ref": "#/$defs/__schema3"
                      }
                    },
                    "required": [
                      "kind",
                      "groupSize"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "tensor"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "channel"
                      },
                      "axisId": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "kind",
                      "axisId"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "block"
                      },
                      "axes": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema6"
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "axes"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "name",
              "dtype",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "payloadBits",
        "packingUnitElements",
        "alignmentBytes",
        "auxiliaries"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "axisId": {
          "$ref": "#/$defs/__schema0"
        },
        "blockSize": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "axisId",
        "blockSize"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "importId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceId": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceName": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceKey": {
          "$ref": "#/$defs/__schema0"
        },
        "sourceLabel": {
          "$ref": "#/$defs/__schema0"
        },
        "auxiliaryKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "note": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "importId",
        "sourceId",
        "sourceName",
        "sourceHash",
        "sourceKey",
        "sourceLabel",
        "auxiliaryKeys",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
