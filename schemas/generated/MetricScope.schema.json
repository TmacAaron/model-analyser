{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "prefill",
        "decode"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "module"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "nodeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "nodeId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "deviceIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "aggregation": {
      "type": "string",
      "enum": [
        "per_device",
        "group_total",
        "model_useful"
      ]
    }
  },
  "required": [
    "phase",
    "target",
    "deviceIds",
    "aggregation"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
