{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceName": {
      "$ref": "#/$defs/__schema0"
    },
    "format": {
      "type": "string",
      "enum": [
        "json",
        "yaml"
      ]
    },
    "rawConfig": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "documentType": {
      "type": "string",
      "const": "config_import_seed"
    },
    "version": {
      "type": "string",
      "const": "config-import.1"
    },
    "assetId": {
      "$ref": "#/$defs/__schema0"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
