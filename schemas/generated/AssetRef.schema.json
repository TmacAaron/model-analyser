{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "model",
        "module",
        "operator",
        "formula",
        "parallel",
        "quantization",
        "hardware"
      ]
    }
  },
  "required": [
    "assetId",
    "revision",
    "kind"
  ],
  "additionalProperties": false
}
