{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "literal"
        },
        "quantity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "enum": [
                "scalar",
                "count",
                "ratio",
                "byte",
                "second",
                "operation",
                "operation_per_second",
                "byte_per_second"
              ]
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "quantity"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "symbol"
        },
        "name": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "formula"
        },
        "call": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "object",
              "properties": {
                "assetId": {
                  "$ref": "#/$defs/__schema0"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "model",
                    "module",
                    "operator",
                    "formula",
                    "parallel",
                    "quantization",
                    "hardware"
                  ]
                }
              },
              "required": [
                "assetId",
                "revision",
                "kind"
              ],
              "additionalProperties": false
            },
            "bindings": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/__schema0"
              },
              "additionalProperties": {
                "$ref": "#"
              }
            }
          },
          "required": [
            "formula",
            "bindings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "call"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
