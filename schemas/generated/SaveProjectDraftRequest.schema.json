{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "draft": {
      "type": "object",
      "properties": {
        "documentType": {
          "type": "string",
          "const": "project_draft"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "draftId": {
          "$ref": "#/$defs/__schema0"
        },
        "projectId": {
          "$ref": "#/$defs/__schema0"
        },
        "baseProjectRevision": {
          "anyOf": [
            {
              "minimum": 1,
              "$ref": "#/$defs/__schema1"
            },
            {
              "type": "null"
            }
          ]
        },
        "draftGeneration": {
          "$ref": "#/$defs/__schema1"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "candidate": {
          "$ref": "#/$defs/__schema2"
        },
        "editorFormat": {
          "type": "string",
          "enum": [
            "json",
            "yaml"
          ]
        }
      },
      "required": [
        "documentType",
        "schemaVersion",
        "draftId",
        "projectId",
        "baseProjectRevision",
        "draftGeneration",
        "updatedAt",
        "candidate"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "draft"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      ]
    }
  }
}
