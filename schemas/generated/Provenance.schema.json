{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "formulaRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "parameterSources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameterKey": {
            "$ref": "#/$defs/__schema1"
          },
          "source": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "parameterKey",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "assetRefs",
    "formulaRefs",
    "parameterSources",
    "assumptions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "assetId": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "model",
            "module",
            "operator",
            "formula",
            "parallel",
            "quantization",
            "hardware"
          ]
        }
      },
      "required": [
        "assetId",
        "revision",
        "kind"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    }
  }
}
