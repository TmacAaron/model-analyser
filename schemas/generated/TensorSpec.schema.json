{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tensorId": {
      "$ref": "#/$defs/__schema0"
    },
    "name": {
      "$ref": "#/$defs/__schema0"
    },
    "shape": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axisId": {
            "$ref": "#/$defs/__schema0"
          },
          "semantic": {
            "type": "string",
            "enum": [
              "batch",
              "token",
              "head",
              "hidden",
              "expert",
              "vocab",
              "custom"
            ]
          },
          "size": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "axisId",
          "semantic",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "dtype": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "float",
            "int",
            "uint",
            "custom"
          ]
        },
        "bits": {
          "$ref": "#/$defs/__schema2"
        },
        "format": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "category",
        "bits",
        "format"
      ],
      "additionalProperties": false
    },
    "storageId": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "tensorId",
    "name",
    "shape",
    "dtype",
    "storageId"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "quantity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "scalar",
                    "count",
                    "ratio",
                    "byte",
                    "second",
                    "operation",
                    "operation_per_second",
                    "byte_per_second"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "call": {
              "type": "object",
              "properties": {
                "formula": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "model",
                        "module",
                        "operator",
                        "formula",
                        "parallel",
                        "quantization",
                        "hardware"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "revision",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "bindings": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema1"
                  }
                }
              },
              "required": [
                "formula",
                "bindings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
