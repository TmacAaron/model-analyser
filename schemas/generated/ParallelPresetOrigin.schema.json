{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "parallel-preset.1"
    },
    "presetId": {
      "$ref": "#/$defs/__schema0"
    },
    "modelId": {
      "$ref": "#/$defs/__schema0"
    },
    "modelRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "groupId": {
      "$ref": "#/$defs/__schema0"
    },
    "meshAxisId": {
      "$ref": "#/$defs/__schema0"
    },
    "expertMesh": {
      "type": "object",
      "properties": {
        "ep": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "tp": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "ep",
        "tp",
        "groupId"
      ],
      "additionalProperties": false
    },
    "requestDp": {
      "type": "integer",
      "minimum": 2,
      "maximum": 64
    },
    "pipelineTp": {
      "type": "integer",
      "minimum": 2,
      "maximum": 64
    },
    "pipelineStage": {
      "type": "object",
      "properties": {
        "presetId": {
          "$ref": "#/$defs/__schema0"
        },
        "degree": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64
        }
      },
      "required": [
        "presetId",
        "degree"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "presetId",
    "modelId",
    "modelRevision",
    "groupId",
    "meshAxisId"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
