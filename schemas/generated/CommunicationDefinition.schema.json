{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "all_reduce",
        "all_gather",
        "reduce_scatter",
        "all_to_all",
        "send_recv"
      ]
    },
    "groupId": {
      "$ref": "#/$defs/__schema0"
    },
    "source": {
      "type": "object",
      "properties": {
        "tensorId": {
          "$ref": "#/$defs/__schema0"
        },
        "distribution": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "tensorId",
        "distribution"
      ],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "tensorId": {
          "$ref": "#/$defs/__schema0"
        },
        "distribution": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "tensorId",
        "distribution"
      ],
      "additionalProperties": false
    },
    "sourceDeviceId": {
      "$ref": "#/$defs/__schema0"
    },
    "destinationDeviceId": {
      "$ref": "#/$defs/__schema0"
    },
    "payloadDtype": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "float",
            "int",
            "uint",
            "custom"
          ]
        },
        "bits": {
          "$ref": "#/$defs/__schema5"
        },
        "format": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "category",
        "bits",
        "format"
      ],
      "additionalProperties": false
    },
    "sendBytesPerMember": {
      "$ref": "#/$defs/__schema4"
    },
    "receiveBytesPerMember": {
      "$ref": "#/$defs/__schema4"
    },
    "algorithm": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/__schema0"
        },
        "trafficFactor": {
          "$ref": "#/$defs/__schema6"
        },
        "startupRounds": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "name",
        "trafficFactor",
        "startupRounds"
      ],
      "additionalProperties": false
    },
    "perDevicePayloads": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "timing": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "custom_formula"
            },
            "seconds": {
              "$ref": "#/$defs/__schema4"
            },
            "description": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "seconds",
            "description"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed"
            },
            "seconds": {
              "$ref": "#/$defs/__schema6"
            },
            "description": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "seconds",
            "description"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bandwidth_latency"
            },
            "bytePerSecond": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "latencySeconds": {
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": [
            "kind",
            "bytePerSecond",
            "latencySeconds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "placement": {
      "type": "object",
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/__schema0"
        },
        "phases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "afterNodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "beforeNodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "nodeId",
        "phases",
        "afterNodeIds",
        "beforeNodeIds"
      ],
      "additionalProperties": false
    },
    "temporaryStorageIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "operation",
    "groupId",
    "source",
    "destination",
    "payloadDtype",
    "sendBytesPerMember",
    "receiveBytesPerMember",
    "algorithm",
    "timing"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "replicated"
            },
            "groupId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "groupId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "partial"
            },
            "groupId": {
              "$ref": "#/$defs/__schema0"
            },
            "reduceOperation": {
              "type": "string",
              "enum": [
                "sum",
                "max",
                "min"
              ]
            }
          },
          "required": [
            "kind",
            "groupId",
            "reduceOperation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sharded"
            },
            "groupId": {
              "$ref": "#/$defs/__schema0"
            },
            "axes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "policy": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "even"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "padded"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "explicit"
                    },
                    "slices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "deviceId": {
                            "$ref": "#/$defs/__schema0"
                          },
                          "axisId": {
                            "$ref": "#/$defs/__schema0"
                          },
                          "start": {
                            "$ref": "#/$defs/__schema3"
                          },
                          "end": {
                            "$ref": "#/$defs/__schema3"
                          }
                        },
                        "required": [
                          "deviceId",
                          "axisId",
                          "start",
                          "end"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "slices"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "kind",
            "groupId",
            "axes",
            "policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "manual"
            },
            "groupId": {
              "$ref": "#/$defs/__schema0"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "localShape": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "axisId": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "semantic": {
                          "type": "string",
                          "enum": [
                            "batch",
                            "token",
                            "head",
                            "hidden",
                            "expert",
                            "vocab",
                            "custom"
                          ]
                        },
                        "size": {
                          "$ref": "#/$defs/__schema4"
                        }
                      },
                      "required": [
                        "axisId",
                        "semantic",
                        "size"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "copies": {
                    "$ref": "#/$defs/__schema5"
                  }
                },
                "required": [
                  "deviceId",
                  "localShape",
                  "copies"
                ],
                "additionalProperties": false
              }
            },
            "description": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "groupId",
            "members",
            "description"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "tensorAxisId": {
          "$ref": "#/$defs/__schema0"
        },
        "meshAxisId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "tensorAxisId",
        "meshAxisId"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "quantity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "scalar",
                    "count",
                    "ratio",
                    "byte",
                    "second",
                    "operation",
                    "operation_per_second",
                    "byte_per_second"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "call": {
              "type": "object",
              "properties": {
                "formula": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "model",
                        "module",
                        "operator",
                        "formula",
                        "parallel",
                        "quantization",
                        "hardware"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "revision",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "bindings": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema4"
                  }
                }
              },
              "required": [
                "formula",
                "bindings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema5": {
      "minimum": 1,
      "$ref": "#/$defs/__schema3"
    },
    "__schema6": {
      "type": "number",
      "minimum": 0
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/__schema0"
        },
        "sendBytes": {
          "$ref": "#/$defs/__schema4"
        },
        "receiveBytes": {
          "$ref": "#/$defs/__schema4"
        },
        "trafficFactor": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "deviceId",
        "sendBytes",
        "receiveBytes",
        "trafficFactor"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "enum": [
        "prefill",
        "decode"
      ]
    }
  }
}
