{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceId": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceName": {
      "$ref": "#/$defs/__schema0"
    },
    "format": {
      "type": "string",
      "const": "ascend-description.1"
    },
    "text": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "sourceId",
    "sourceName",
    "format",
    "text",
    "sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    }
  }
}
