{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "json",
        "yaml"
      ]
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "sourceName",
    "format",
    "text"
  ],
  "additionalProperties": false
}
