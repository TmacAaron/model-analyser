{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capacityBytes": {
      "$ref": "#/$defs/__schema0"
    },
    "computeCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "computeClass": {
            "type": "object",
            "properties": {
              "arithmetic": {
                "type": "string",
                "enum": [
                  "float",
                  "integer"
                ]
              },
              "inputDtypes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "multiplyDtype": {
                "$ref": "#/$defs/__schema1"
              },
              "accumulateDtype": {
                "$ref": "#/$defs/__schema1"
              },
              "resource": {
                "type": "string",
                "enum": [
                  "matrix",
                  "vector",
                  "custom"
                ]
              },
              "resourceKey": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "required": [
              "arithmetic",
              "inputDtypes",
              "multiplyDtype",
              "accumulateDtype",
              "resource"
            ],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": [
              "peak",
              "effective"
            ]
          },
          "operationsPerSecond": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "computeClass",
          "kind",
          "operationsPerSecond"
        ],
        "additionalProperties": false
      }
    },
    "memoryCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/__schema2"
          },
          "kind": {
            "type": "string",
            "enum": [
              "peak",
              "effective"
            ]
          },
          "bytesPerSecond": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "key",
          "kind",
          "bytesPerSecond"
        ],
        "additionalProperties": false
      }
    },
    "communicationDefaults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "intra_group",
              "inter_group"
            ]
          },
          "bytesPerSecond": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "latencySeconds": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "scope",
          "bytesPerSecond",
          "latencySeconds",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "capacityBytes",
    "computeCapabilities",
    "memoryCapabilities",
    "communicationDefaults"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "float",
            "int",
            "uint",
            "custom"
          ]
        },
        "bits": {
          "minimum": 1,
          "$ref": "#/$defs/__schema0"
        },
        "format": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "category",
        "bits",
        "format"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    }
  }
}
