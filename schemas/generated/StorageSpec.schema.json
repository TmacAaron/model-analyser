{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "storageId": {
      "$ref": "#/$defs/__schema0"
    },
    "name": {
      "$ref": "#/$defs/__schema0"
    },
    "category": {
      "type": "string",
      "enum": [
        "weight",
        "state",
        "activation",
        "workspace",
        "communication",
        "graph",
        "runtime",
        "reserve"
      ]
    },
    "sharingDomain": {
      "type": "string",
      "enum": [
        "request",
        "instance",
        "device_group"
      ]
    },
    "allocation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tensor"
            },
            "shape": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "axisId": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "semantic": {
                    "type": "string",
                    "enum": [
                      "batch",
                      "token",
                      "head",
                      "hidden",
                      "expert",
                      "vocab",
                      "custom"
                    ]
                  },
                  "size": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "required": [
                  "axisId",
                  "semantic",
                  "size"
                ],
                "additionalProperties": false
              }
            },
            "dtype": {
              "$ref": "#/$defs/__schema3"
            },
            "quantization": {
              "type": "object",
              "properties": {
                "payloadBits": {
                  "$ref": "#/$defs/__schema2"
                },
                "payloadDtype": {
                  "$ref": "#/$defs/__schema3"
                },
                "packingUnitElements": {
                  "$ref": "#/$defs/__schema2"
                },
                "alignmentBytes": {
                  "$ref": "#/$defs/__schema2"
                },
                "auxiliaries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "$ref": "#/$defs/__schema0"
                      },
                      "dtype": {
                        "$ref": "#/$defs/__schema3"
                      },
                      "count": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "formula"
                              },
                              "value": {
                                "$ref": "#/$defs/__schema1"
                              }
                            },
                            "required": [
                              "kind",
                              "value"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "group"
                              },
                              "groupSize": {
                                "$ref": "#/$defs/__schema2"
                              }
                            },
                            "required": [
                              "kind",
                              "groupSize"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "tensor"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "channel"
                              },
                              "axisId": {
                                "$ref": "#/$defs/__schema0"
                              }
                            },
                            "required": [
                              "kind",
                              "axisId"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "block"
                              },
                              "axes": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "$ref": "#/$defs/__schema4"
                                }
                              }
                            },
                            "required": [
                              "kind",
                              "axes"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "dtype",
                      "count"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "payloadBits",
                "packingUnitElements",
                "alignmentBytes",
                "auxiliaries"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "shape",
            "dtype"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bytes"
            },
            "value": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "alias"
            },
            "targetStorageId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "targetStorageId"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "storageId",
    "name",
    "category",
    "sharingDomain",
    "allocation"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "literal"
            },
            "quantity": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "scalar",
                    "count",
                    "ratio",
                    "byte",
                    "second",
                    "operation",
                    "operation_per_second",
                    "byte_per_second"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "quantity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "symbol"
            },
            "name": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "formula"
            },
            "call": {
              "type": "object",
              "properties": {
                "formula": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "model",
                        "module",
                        "operator",
                        "formula",
                        "parallel",
                        "quantization",
                        "hardware"
                      ]
                    }
                  },
                  "required": [
                    "assetId",
                    "revision",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "bindings": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema1"
                  }
                }
              },
              "required": [
                "formula",
                "bindings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "float",
            "int",
            "uint",
            "custom"
          ]
        },
        "bits": {
          "$ref": "#/$defs/__schema2"
        },
        "format": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "category",
        "bits",
        "format"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "axisId": {
          "$ref": "#/$defs/__schema0"
        },
        "blockSize": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "axisId",
        "blockSize"
      ],
      "additionalProperties": false
    }
  }
}
