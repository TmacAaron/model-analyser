    "ulysses": {
      "checkedOn": "2026-11-14",
      "repository": "https://github.com/deepspeedai/DeepSpeed",
      "commit": "79caae1c04fca210345bdeb03bcacf87b1ac2f23",
      "path": "blogs/deepspeed-ulysses/README.md",
      "url": "https://github.com/deepspeedai/DeepSpeed/blob/79caae1c04fca210345bdeb03bcacf87b1ac2f23/blogs/deepspeed-ulysses/README.md",
      "rawUrl": "https://raw.githubusercontent.com/deepspeedai/DeepSpeed/79caae1c04fca210345bdeb03bcacf87b1ac2f23/blogs/deepspeed-ulysses/README.md",
      "sha256": "49d730cb416643bfd73eeae3217027ae00778ce604b58ea19be34588248e543b",
      "section": "Core Design of DeepSpeed-Ulysses",
      "verifiedSemantics": [
        "Sequences are partitioned before attention; all-to-all converts Q/K/V into full-sequence, disjoint-head layouts.",
        "The return all-to-all restores sequence partitioning for subsequent operators.",
        "Sequence parallelism alone does not shard model weights; ZeRO is a separate mechanism."
      ],
      "authoredAssumptions": [
        "This project is a forward-only materialized dense MHA subgraph, not the paper's full training stack or a production model.",
        "Three separate Q/K/V exchanges incur three startups; no fused QKV communication or zero-cost packing is claimed.",
        "Whole local payload includes the self block; an explicit pairwise factor (P-1)/P accounts for remote bytes once, with P-1 startup rounds.",
        "Separate source/destination buffers are allocated; zero extra transport workspace is an explicit ideal-buffer assumption. Local communication HBM is unknown.",
        "All rates, capacity, efficiency, softmax operation proxy and full FP32 scratch below are artificial author declarations, not sourced benchmarks.",
        "Dense unmasked attention on the current prefill sequence only; no KV cache, causal mask, RoPE, norm, MLP, backward or optimizer. Past context must be zero."
      ]
    },
    "moe": {
      "checkedOn": "2026-11-14",
      "repository": "https://github.com/NVIDIA/Megatron-LM",
      "commit": "76cf2e2d64bbfa466d50de64d036db23395dc5af",
      "path": "megatron/core/transformer/moe/token_dispatcher.py",
      "url": "https://github.com/NVIDIA/Megatron-LM/blob/76cf2e2d64bbfa466d50de64d036db23395dc5af/megatron/core/transformer/moe/token_dispatcher.py",
      "sha256": "b1580f97c0166107dcd90306144d60550a4a75e169bb56efaddaa8200c92604b",
      "verifiedSemantics": [
        "The explicit all-to-all dispatcher separates dispatch, tensor-parallel gathering, expert computation, tensor-parallel reduction/scattering and inverse combine.",
        "The flex dispatcher can use a group spanning both tensor- and expert-parallel ranks."
      ],
      "authoredAssumptions": [
        "Forward-only synthetic E=4, top-k=2 gated MoE subgraph, with EP=2 and TP=1 or 2; all experts remain resident.",
        "Every global token routes to one expert in each owner. The balanced profile touches both experts per owner; the concentrated profile touches one, with the same number of token assignments.",
        "Route packets carry BF16 activations, int64 expert indices and FP32 probabilities: 2H+12 bytes per assignment. Token order is known from the declared fixed routing map.",
        "One TP×EP dispatch and two separate owner combine collectives are declared; these are not a claim to reproduce a fused production dispatcher.",
        "Owner preparation/unpacking and repacking use distinct buffers with explicit HBM traffic. Transport workspace=0 is an ideal-buffer assumption; communication local HBM and reduction arithmetic remain unknown.",
        "Artificial matrix/vector ceilings 1000 operations/s, HBM 100 byte/s, network 1000 byte/s, per-round latency 0.001 seconds, and 4096-byte devices are arithmetic references only."
      ]
    }
  },
