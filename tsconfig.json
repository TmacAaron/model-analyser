{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "jsx": "react-jsx", "noEmit": true, "types": ["node", "vite/client"],
    "paths": {"@model-analyser/contracts": ["./packages/contracts/src/index.ts"], "@model-analyser/core": ["./packages/core/src/index.ts"]}
  },
  "include": ["packages", "apps", "scripts", "tests"]
}
