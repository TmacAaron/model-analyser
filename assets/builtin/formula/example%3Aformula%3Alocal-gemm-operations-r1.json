{
  "documentType": "asset",
  "schemaVersion": 1,
  "assetId": "example:formula:local-gemm-operations",
  "revision": 1,
  "name": "局部 GEMM 工作量（允许空有效切片）",
  "tags": [
    "synthetic-local-cost"
  ],
  "parameters": [],
  "sources": [
    {
      "kind": "note",
      "text": "一次乘加计两次运算；C01 手算基线"
    }
  ],
  "definition": {
    "kind": "formula",
    "formula": {
      "inputs": {
        "M": {
          "unit": "count",
          "integerRequired": true,
          "min": 0
        },
        "N": {
          "unit": "count",
          "integerRequired": true,
          "min": 0
        },
        "K": {
          "unit": "count",
          "integerRequired": true,
          "min": 0
        }
      },
      "expression": "2 * M * N * K",
      "output": {
        "unit": "operation",
        "integerRequired": false,
        "nonNegative": true
      },
      "description": "数学运算次数，与存储位宽分开计量"
    }
  }
}
