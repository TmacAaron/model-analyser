  "definition": {
    "kind": "formula",
    "formula": {
      "inputs": {
        "rows": {
          "unit": "count",
          "integerRequired": true,
          "min": 1
        },
        "cols": {
          "unit": "count",
          "integerRequired": true,
          "min": 1
        }
      },
      "expression": "rows * cols * 2",
      "output": {
        "unit": "byte",
        "integerRequired": true,
        "nonNegative": true
      },
      "description": "C01 BF16 matrix storage bytes"
    }
